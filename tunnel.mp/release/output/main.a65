@UnitInit

; optimize FAIL ('MISC.DETECTANTIC', RMT), line = 168

	jsr MISC.DETECTANTIC
	lda MISC.DETECTANTIC.RESULT
	jeq l_0170

; optimize OK (RMT), line = 169

	lda #$00
	jmp l_017E
l_0170

; optimize OK (RMT), line = 171

	lda #$04
l_017E
	sta NTSC

	rts

; ------------------------------------------------------------

NTSC	= DATAORIGIN+$00AC
PLAYER_ENABLED	= DATAORIGIN+$00AD

