; ------------------------------------------------------------

.local	B_SYSTEM					; UNIT

.local	SYSTEMOFF					; PROCEDURE | ASSEMBLER | OVERLOAD
.local	@010180000
	sta PORT_B

; -------------------  ASM Block 00000128  -------------------


		;lda:cmp:req 20 ;; removed due to problem with nmien = 0 already set
		sei
		mva #0 NMIEN

		mva port_b PORTB
		mwa #__nmi NMIVEC

		lda <__iret
		sta IRQVEC
		sta __vblvec
		sta __dlivec

		lda >__iret
		sta IRQVEC+1
		sta __vblvec+1
		sta __dlivec+1

		mva #$40 NMIEN
		sta __nmien
		bne __stop
__nmi
		bit NMIST
		bpl __vbl
		jmp __dlivec
.def :__dlivec = *-2
		rti
__vbl
		inc rtclok+2
		bne __vblvec-1
		inc rtclok+1
		bne __vblvec-1
		inc rtclok
		jmp __vblvec
.def :__vblvec = *-2
.def :__iret
    	rti
__stop

; ------------------------------------------------------------

PORT_B	= DATAORIGIN+$00C1

@VarData	= PORT_B
@VarDataSize	= 1

@exit
	.ifdef @new
	lda <@VarData
	sta :ztmp
	lda >@VarData
	ldy #@VarDataSize-1
	jmp @FreeMem
	els
	rts						; ret
	eif
.endl
.endl							; overload

.local	SYSTEMOFF					; PROCEDURE | OVERLOAD
.local	@00

; optimize OK (B_SYSTEM), line = 180

	lda #$FE
	jsr SYSTEMOFF.@010180000

@exit
	.ifdef @new
	lda <@VarData
	sta :ztmp
	lda >@VarData
