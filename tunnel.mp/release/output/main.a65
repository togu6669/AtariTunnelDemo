	els
	rts						; ret
	eif
.endl
.endl							; overload

.local	ENABLEDLI					; PROCEDURE | ASSEMBLER

; -------------------  ASM Block 00000135  -------------------


		lda:cmp:req 20
		mva #0 NMIEN
		mwa dliptr __dlivec
		mva #$c0 NMIEN
		sta __nmien

; ------------------------------------------------------------

