.local	TRMT.PLAY					; PROCEDURE | ASSEMBLER
	sta TRMT
	sty TRMT+1
	sta PLAYER
	sty PLAYER+1
	add #2
	scc
	iny
	sta MODUL
	sty MODUL+1

; -------------------  ASM Block 00000110  -------------------

	txa:pha

	lda player_enabled
	beq quit

	asl ntsc		; =0 PAL, =4 NTSC
	bcc skp

	lda #%00000100
	sta ntsc

	bne quit
skp
	mwa TRMT adr+1

	ldy #1
adr	lda $ffff,y
	sta ptr+2

ptr	jsr $ff00		; jmp (TRMT)	6502 buggy indirect jump

quit	pla:tax

